# Copy to .env and fill in. The CLI loads this file without overriding real env.
# Never commit the real .env. It is gitignored. Keep it outside the repository: put it in
# ~/.config/promptmend/.env ($XDG_CONFIG_HOME/promptmend/.env when XDG_CONFIG_HOME is
# set; %APPDATA%\promptmend\.env on Windows), or set
# PROMPTMEND_ENV=/path/to/.env in the real environment (not in a .env file). The CLI also
# reads the .env in this repository (editable install), but an API key there sits in the
# working tree. Once config.toml exists in the config folder above, no .env is read (unless
# PROMPTMEND_ENV names one). Save it as UTF-8. An unquoted value ends at " #" (a
# comment): quote a value that contains " #", such as a regex or a persona.
#
# Only the key and the persona are set below. Every other line shows its default, commented
# out: uncomment a line only to change it, so later default changes still reach you.

# PROMPT_PROVIDER=openrouter
# PROMPT_PROFILE=default
# Your role, stated in the first person. Opens the CONTEXT section of the `default`
# profile's rewrite and the `-p-` snippet. Leave empty for no fixed persona.
PROMPT_PERSONA=
# PROMPT_PERSONA="I am working as a Head of Data at Example Corp."
# paste (the rewrite replaces the trigger) or clipboard (the trigger vanishes and the rewrite
# is on the clipboard; error markers still paste). improve --output overrides it per call.
# PROMPT_OUTPUT=paste
# PROMPT_TIMEOUT_SECONDS=30
# Timeout for the pro tier (-ip-), which runs a slower reasoning model.
# PROMPT_PRO_TIMEOUT_SECONDS=60
# Profile for the pro tier (-ip-, and -if- when it runs OPENROUTER_PRO_MODEL); empty uses
# PROMPT_PROFILE, so both tiers send the same prompt.
# PROMPT_PRO_PROFILE=
# Your own profiles are <name>.md files in ~/.config/promptmend/profiles/
# (%APPDATA%\promptmend\profiles\ on Windows). One named like a built-in (default,
# general) is ignored unless that built-in is listed here, comma-separated.
# PROMPT_PROFILE_OVERRIDES=
# Empty (PROMPT_TEMPERATURE=) sends no temperature, for models that reject the field;
# leaving it unset keeps 0.2.
# PROMPT_TEMPERATURE=0.2

# Local providers are ungated only on localhost. Pointed at another machine, or with an
# Ollama cloud model (a :cloud or -cloud tag, any case), the draft leaves this one, so the
# data-protection gate applies as it does to the cloud providers. Unlike the cloud providers
# they accept http:// for another machine, which sends the draft in clear text over the
# network: use https:// (or an SSH tunnel to localhost) there.

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_THINK=false
# Context window in tokens (options.num_ctx); empty = Ollama's own, which depends on its
# version, the model and available memory. Ollama may shorten a longer prompt without
# reporting an error; local models only, a cloud-tagged model uses its own context.
# OLLAMA_NUM_CTX=

# LM Studio (OpenAI-compatible, local, no key needed)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model

# OpenRouter (cloud, default provider). Leave key empty if company policy
# does not permit sending drafts off-machine; the data-protection gate blocks
# sensitive content regardless. For local-only use set PROMPT_LOCAL_ONLY=true below:
# the cloud triggers name their provider, so PROMPT_PROVIDER does not change them.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_TOKENS=2400
# Pin one serving endpoint. OpenRouter routes a model across many hosts that differ in
# latency, price and output quality; see docs/benchmark.md. List the tags
# with GET https://openrouter.ai/api/v1/models/<author>/<slug>/endpoints. Leave empty for
# OpenRouter's own blended routing.
# OPENROUTER_PROVIDER=google-ai-studio/flex
# true keeps the pin a preference, so a dead endpoint falls back instead of erroring.
# false pins hard: predictable cost and latency, but outages become visible failures.
# OPENROUTER_ALLOW_FALLBACKS=true
# Data policy for every OpenRouter call (both tiers): deny routes only to endpoints that
# do not store or train on requests (fewer endpoints; a pin that does not qualify falls
# back, or fails with ALLOW_FALLBACKS=false), allow permits them. Empty sends nothing, so
# your OpenRouter account setting applies.
# OPENROUTER_DATA_COLLECTION=
# Reasoning effort (none/minimal/low/medium/high). Leave empty for models without a
# reasoning control. Gemini 3.x cannot turn thinking off; minimal keeps it fast.
# OPENROUTER_REASONING_EFFORT=minimal
# Pro tier (-ip- / --tier pro): a reasoning model for hard, multi-part drafts.
# OPENROUTER_PRO_MODEL=openai/gpt-6-luna
# OPENROUTER_PRO_PROVIDER=openai
# OPENROUTER_PRO_REASONING_EFFORT=low
# Output cap for the pro tier only (its reasoning counts against it). Empty uses
# OPENROUTER_MAX_TOKENS for both tiers.
# OPENROUTER_PRO_MAX_TOKENS=

# Anthropic / Claude (cloud). Leave key empty unless policy permits cloud use.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=2400

# Set true only to allow cloud calls on every flagged draft, permanently. To send one draft
# whose findings are only labels, IDs, emails or IBANs, use the -iok- trigger instead.
# ALLOW_CLOUD_OVERRIDE=false
# Set true to refuse every provider that can send the draft off this machine (-i-, -ip-, -if-,
# -iok-, -ic-, and local providers pointed elsewhere); -il- and -ilm- on localhost keep working.
# PROMPT_LOCAL_ONLY=false
# Set true when your localhost Ollama / LM Studio is a relay to a cloud API (LiteLLM, an SSH
# tunnel), or when OLLAMA_MODEL is a local alias of a cloud model (made with ollama cp, so its
# name has no cloud tag and counts as local): -il- and -ilm- then
# run the gate too. PROMPT_LOCAL_ONLY still allows them.
# PROMPT_GATE_LOCAL=false
# Your own ;-separated, case-insensitive regexes the gate also blocks on, e.g. project code
# names or customer-ID formats. Write a literal ; as \x3b. An invalid regex is rejected when
# settings load. Each pattern runs on every draft and on every value written to the usage
# history: avoid nested quantifiers such as (\w+\s?)+, which can take exponential time and
# stall the trigger; use a literal, a fixed count (\d{6}) or a bounded repeat (\w{1,20}).
# PROMPT_EXTRA_PATTERNS=
# PROMPT_EXTRA_PATTERNS="project[- ]falcon;CUST-\d{6}"

# Local usage history: metadata only (trigger, model, tokens, reported cost, latency), never
# your draft, rewrite, persona or keys; kept on this device in ~/.local/share/promptmend
# (%LOCALAPPDATA%\promptmend on Windows). false keeps no history.
# PROMPT_HISTORY=true
# Days a history record is kept (1 to 36500); each recorded run prunes older ones.
# PROMPT_HISTORY_RETENTION_DAYS=365

# `promptmend doctor` and the interface's Home ask pypi.org, once a day, whether a
# newer release exists; false makes no request. The triggers never ask.
# PROMPT_UPDATE_CHECK=true
